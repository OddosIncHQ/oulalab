<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_auction" model="ir.ui.view">
        <field name="name">res.partner.form.auction</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Subastas OulaLab" name="oulalab_auction">
                    <group>
                        <field name="is_oulalab_member"/>
                        <field name="auction_delivery_mode"/>
                        <field name="auction_commune"
                               invisible="auction_delivery_mode != 'delivery'"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
