<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="auction_detail_template" name="OulaLab Auction Detail">
        <t t-call="website.layout">
            <div class="container my-5 oulalab-auction-detail"
                 t-att-data-auction-id="auction.id">
                <t t-if="guest_session">
                    <div class="alert alert-secondary d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                        <span>Estás como <strong t-out="guest_name"/> (RUT <t t-out="guest_rut"/>).</span>
                        <a href="/auctions/guest/logout" class="btn btn-sm btn-outline-danger">Salir / cambiar de RUT</a>
                    </div>
                </t>
                <div class="mb-3 d-flex gap-2 flex-wrap">
                    <a href="/auctions" class="btn btn-outline-dark btn-sm">← Volver a las subastas</a>
                    <a href="/auctions/mis-subastas" class="btn btn-outline-secondary btn-sm">Mis subastas</a>
                </div>
                <div class="row g-5">
                    <!-- Imágenes (carrusel) -->
                    <div class="col-12 col-md-6">
                        <t t-set="urls" t-value="auction._get_image_urls()"/>
                        <t t-if="urls">
                            <div t-attf-id="oulalabCarousel#{auction.id}"
                                 class="carousel slide oulalab-carousel" data-bs-ride="false">
                                <!-- Indicadores (solo si hay más de 1) -->
                                <div class="carousel-indicators" t-if="len(urls) &gt; 1">
                                    <t t-foreach="urls" t-as="u">
                                        <button type="button"
                                                t-attf-data-bs-target="#oulalabCarousel#{auction.id}"
                                                t-att-data-bs-slide-to="u_index"
                                                t-attf-class="#{'active' if u_index == 0 else ''}"
                                                t-att-aria-current="'true' if u_index == 0 else None"
                                                t-attf-aria-label="Imagen #{u_index + 1}"/>
                                    </t>
                                </div>
                                <!-- Slides -->
                                <div class="carousel-inner rounded shadow-sm">
                                    <t t-foreach="urls" t-as="u">
                                        <div t-attf-class="carousel-item #{'active' if u_index == 0 else ''}">
                                            <img t-att-src="u" class="d-block w-100"
                                                 t-attf-alt="Imagen #{u_index + 1} de la prenda"/>
                                        </div>
                                    </t>
                                </div>
                                <!-- Controles (solo si hay más de 1) -->
                                <t t-if="len(urls) &gt; 1">
                                    <button class="carousel-control-prev" type="button"
                                            t-attf-data-bs-target="#oulalabCarousel#{auction.id}"
                                            data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"/>
                                        <span class="visually-hidden">Anterior</span>
                                    </button>
                                    <button class="carousel-control-next" type="button"
                                            t-attf-data-bs-target="#oulalabCarousel#{auction.id}"
                                            data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"/>
                                        <span class="visually-hidden">Siguiente</span>
                                    </button>
                                </t>
                            </div>
                        </t>
                        <!-- Fallback: imagen del producto si no hay URLs -->
                        <t t-elif="auction.image_128">
                            <img t-attf-src="/web/image/liquidation.auction/#{auction.id}/image_128"
                                 class="img-fluid rounded shadow-sm" alt="Prenda"/>
                        </t>
                    </div>

                    <!-- Info + oferta -->
                    <div class="col-12 col-md-6">
                        <h1 t-out="auction.web_title or 'Prenda en subasta'"/>
                        <p class="mb-2" t-if="auction.size">Talla: <strong t-out="auction.size"/></p>
                        <p class="mb-2 small text-muted" t-if="auction.barcode">Código de barras: <span t-out="auction.barcode"/></p>
                        <div class="text-muted" t-out="auction.web_description"/>

                        <div class="mb-3">
                            <span class="text-muted">Precio mínimo: </span>
                            <strong>
                                <t t-out="auction.currency_id.symbol"/>
                                <t t-out="'{:,.0f}'.format(auction.reserve_price)"/>
                            </strong>
                        </div>
                        <div class="mb-3" t-if="auction.retail_price">
                            <span class="text-muted">Precio retail de referencia: </span>
                            <strong>
                                <t t-out="auction.currency_id.symbol"/>
                                <t t-out="'{:,.0f}'.format(auction.retail_price)"/>
                            </strong>
                        </div>

                        <div class="card p-3 mb-3">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Oferta más alta</span>
                                <strong class="oulalab-highest">
                                    <t t-out="auction.currency_id.symbol"/>
                                    <t t-out="'{:,.0f}'.format(auction.highest_amount or 0)"/>
                                </strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">N.º de ofertas</span>
                                <span class="oulalab-bidcount" t-out="auction.bid_count"/>
                            </div>
                            <hr class="my-2"/>
                            <div class="oulalab-timer text-center"
                                 t-att-data-end="auction.end_date"
                                 t-att-data-now="server_now">
                                <small class="text-muted">Cierra en</small>
                                <div class="timer-value fs-4 fw-bold">—</div>
                            </div>
                        </div>

                        <!-- Aviso ventana socios -->
                        <t t-if="auction.public_start and server_now &lt; auction.public_start and auction.member_preview_hours">
                            <div t-attf-class="alert #{'alert-success' if is_member else 'alert-warning'}">
                                <t t-if="is_member">
                                    Estás en la <strong>ventana exclusiva para socios</strong>. ¡Subasta antes que el público!
                                </t>
                                <t t-else="">
                                    Ventana exclusiva para socios OulaLab.
                                    La apertura pública es el
                                    <strong t-out="auction.public_start"/>.
                                </t>
                            </div>
                        </t>

                        <t t-if="auction.public_start and server_now &lt; auction.public_start and not auction.member_preview_hours">
                            <div class="alert alert-info">
                                La subasta abre para todo el público el
                                <strong t-out="auction.public_start"/>.
                            </div>
                        </t>

                        <!-- 1) Sin cuenta ni sesión verificada -> identificación por RUT + código -->
                        <t t-if="is_public">
                            <div class="oulalab-guest-box card p-3">
                                <h5>Ingresa para subastar</h5>
                                <p class="small text-muted">
                                    Si eres socia OulaLab, ingresa tu RUT y te enviaremos un código
                                    al correo que ya tenemos registrado. Si es tu primera vez, completa tus datos.
                                </p>

                                <!-- Paso A: RUT -->
                                <div class="oulalab-g-rutstep">
                                    <label class="form-label">RUT</label>
                                    <input type="text" class="form-control mb-2 oulalab-g-rut-only"
                                           placeholder="12.345.678-5"/>
                                    <button class="btn btn-dark w-100 oulalab-g-lookup" type="button">
                                        Continuar
                                    </button>
                                </div>

                                <!-- Paso B: datos completos (RUT nuevo) -->
                                <div class="oulalab-g-step1" style="display:none;">
                                    <p class="small mb-2 oulalab-g-newnote"></p>
                                    <label class="form-label">RUT</label>
                                    <input type="text" class="form-control mb-2 oulalab-g-rut" readonly="readonly"/>
                                    <label class="form-label">Nombre completo</label>
                                    <input type="text" class="form-control mb-2 oulalab-g-name"/>
                                    <label class="form-label">Correo electrónico</label>
                                    <input type="email" class="form-control mb-2 oulalab-g-email"/>
                                    <label class="form-label">Teléfono de contacto</label>
                                    <input type="tel" class="form-control mb-3 oulalab-g-phone"/>
                                    <h6>¿Cómo quieres recibir la prenda?</h6>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="radio" name="gdelivmode"
                                               id="gModePickup" value="pickup"/>
                                        <label class="form-check-label" for="gModePickup">
                                            Retiro en showroom — <span t-out="showroom"/>
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="gdelivmode"
                                               id="gModeDelivery" value="delivery"/>
                                        <label class="form-check-label" for="gModeDelivery">
                                            Despacho a domicilio
                                        </label>
                                    </div>
                                    <div class="oulalab-g-fields mt-2" style="display:none;">
                                        <select class="form-select mb-2 oulalab-g-commune">
                                            <option value="">Comuna…</option>
                                            <t t-foreach="communes" t-as="c">
                                                <option t-att-value="c[0]" t-out="c[1]"/>
                                            </t>
                                        </select>
                                        <input type="text" class="form-control mb-2 oulalab-g-street"
                                               placeholder="Dirección de despacho"/>
                                        <p class="text-muted small mb-0">
                                            Solo despachamos a Lo Barnechea, Las Condes y Vitacura.
                                        </p>
                                    </div>
                                    <button class="btn btn-dark mt-3 w-100 oulalab-g-send" type="button">
                                        Enviar código a mi correo
                                    </button>
                                </div>

                                <!-- Paso C: código (correo ya registrado o recién ingresado) -->
                                <div class="oulalab-g-step2" style="display:none;">
                                    <p class="small mb-2 oulalab-g-sent-msg"></p>
                                    <input type="text" inputmode="numeric" maxlength="6"
                                           class="form-control mb-2 oulalab-g-code"
                                           placeholder="000000"/>
                                    <button class="btn btn-dark w-100 oulalab-g-verify" type="button">
                                        Verificar y continuar
                                    </button>
                                </div>
                                <div class="oulalab-g-feedback small mt-2 text-danger"></div>
                            </div>
                        </t>

                        <!-- 1b) Socio en ventana de preview: el público aún no puede subastar -->
                        <t t-elif="preview_locked">
                            <div class="oulalab-lock-box card p-3 text-center"
                                 t-att-data-remaining-ms="remaining_ms">
                                <h5>Subasta exclusiva para socias por ahora</h5>
                                <p class="mb-1">
                                    El público general podrá subastar a partir de
                                </p>
                                <p class="fs-5 fw-bold mb-2" t-out="auction.public_start"/>
                                <p class="small text-muted mb-0">
                                    La página se actualizará sola cuando se abra.
                                </p>
                            </div>
                        </t>

                        <!-- 2) Logueado pero sin datos de entrega -> formulario previo -->
                        <t t-elif="not delivery_ready">
                            <div class="oulalab-delivery-box card p-3">
                                <h5>Antes de subastar, verifica tus datos</h5>
                                <label class="form-label mt-2">RUT</label>
                                <input type="text" class="form-control mb-3 oulalab-rut"
                                       placeholder="12.345.678-5"/>
                                <h6>¿Cómo quieres recibir la prenda?</h6>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="radio" name="delivmode"
                                           id="modePickup" value="pickup"/>
                                    <label class="form-check-label" for="modePickup">
                                        Retiro en showroom —
                                        <span t-out="showroom"/>
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="delivmode"
                                           id="modeDelivery" value="delivery"/>
                                    <label class="form-check-label" for="modeDelivery">
                                        Despacho a domicilio
                                    </label>
                                </div>
                                <!-- Campos de despacho (visibles solo si elige despacho) -->
                                <div class="oulalab-delivery-fields mt-2" style="display:none;">
                                    <select class="form-select mb-2 oulalab-commune">
                                        <option value="">Comuna…</option>
                                        <t t-foreach="communes" t-as="c">
                                            <option t-att-value="c[0]" t-out="c[1]"/>
                                        </t>
                                    </select>
                                    <input type="text" class="form-control mb-2 oulalab-street"
                                           placeholder="Dirección de despacho"/>
                                    <input type="text" class="form-control mb-2 oulalab-phone"
                                           placeholder="Teléfono de contacto"/>
                                    <p class="text-muted small mb-0">
                                        Solo despachamos a Lo Barnechea, Las Condes y Vitacura.
                                        Fuera de esas comunas, elige retiro en showroom.
                                    </p>
                                </div>
                                <button class="btn btn-dark mt-3 oulalab-delivery-btn" type="button">
                                    Guardar y continuar
                                </button>
                                <div class="oulalab-delivery-feedback small mt-2 text-danger"></div>
                            </div>
                        </t>

                        <!-- 3) Logueado y con entrega lista -> formulario de oferta -->
                        <t t-else="">
                            <p class="small text-muted mb-2">
                                Entrega:
                                <strong t-if="partner.auction_delivery_mode == 'pickup'">
                                    Retiro en showroom
                                </strong>
                                <strong t-else="">
                                    Despacho a <t t-out="dict(communes).get(partner.auction_commune)"/>
                                </strong>
                                · <a t-attf-href="/auctions/#{auction.id}?edit_delivery=1">cambiar</a>
                            </p>
                            <div class="oulalab-bid-box">
                                <label class="form-label">
                                    Tu oferta (mínimo
                                    <span class="oulalab-minnext fw-bold">
                                        <t t-out="auction.currency_id.symbol"/><t t-out="'{:,.0f}'.format(min_next)"/>
                                    </span>)
                                </label>
                                <div class="input-group">
                                    <input type="number" class="form-control oulalab-bid-input"
                                           t-att-min="min_next" t-att-value="int(min_next)"
                                           t-att-data-min="min_next"/>
                                    <button class="btn btn-danger oulalab-bid-btn" type="button">
                                        Subastar
                                    </button>
                                </div>
                                <div class="oulalab-bid-feedback small mt-2"></div>
                                <p class="text-muted small mt-2" t-if="is_member">
                                    Como socio pagas un incremento menor
                                    (<t t-out="auction.member_increment_pct"/>% vs
                                    <t t-out="auction.public_increment_pct"/>% público).
                                </p>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
