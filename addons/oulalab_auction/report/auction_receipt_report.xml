<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Informe propio de subastas. No toca la plantilla de pedido de venta
         (sale.report_saleorder_document), que el negocio usa para suscripciones. -->
    <record id="action_report_auction_receipt" model="ir.actions.report">
        <field name="name">Comprobante de subasta</field>
        <field name="model">liquidation.auction</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">oulalab_auction.report_auction_receipt</field>
        <field name="report_file">oulalab_auction.report_auction_receipt</field>
        <field name="print_report_name">'Comprobante %s' % (object.sale_order_id.name or object.name)</field>
        <field name="binding_model_id" ref="model_liquidation_auction"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_auction_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mb-1">Comprobante de subasta</h2>
                        <p class="mb-4">
                            <strong t-out="doc.sale_order_id.name or doc.name"/>
                        </p>

                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Adjudicatario</strong>
                                <div t-if="doc.winner_id">
                                    <div t-out="doc.winner_id.name"/>
                                    <div t-if="doc.winner_id.vat">RUT: <span t-out="doc.winner_id.vat"/></div>
                                    <div t-if="doc.winner_id.email" t-out="doc.winner_id.email"/>
                                    <div t-if="doc.winner_id.phone" t-out="doc.winner_id.phone"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <strong>Entrega</strong>
                                <div t-if="doc.winner_id.auction_delivery_mode == 'pickup'">
                                    Retiro en showroom<br/>
                                    Av. La Dehesa 222, of. 817, Lo Barnechea
                                </div>
                                <div t-elif="doc.winner_id.auction_delivery_mode == 'delivery'">
                                    Despacho a domicilio<br/>
                                    <span t-out="doc.winner_id.street"/><br/>
                                    <span t-out="dict(doc.winner_id._fields['auction_commune'].selection).get(doc.winner_id.auction_commune, '')"/>
                                </div>
                            </div>
                        </div>

                        <table class="table table-sm mb-4">
                            <thead>
                                <tr>
                                    <th>Prenda</th>
                                    <th>Talla</th>
                                    <th>Código de barras</th>
                                    <th class="text-end">Monto adjudicado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td t-out="doc.web_title or doc.product_id.name"/>
                                    <td t-out="doc.size or ''"/>
                                    <td t-out="doc.barcode or ''"/>
                                    <td class="text-end">
                                        <span t-out="doc.highest_amount"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row">
                            <div class="col-6">
                                <strong>Cierre de la subasta</strong>
                                <div t-out="doc.end_date" t-options='{"widget": "datetime"}'/>
                            </div>
                            <div class="col-6">
                                <strong>Plazo de pago</strong>
                                <div t-if="doc.payment_deadline"
                                     t-out="doc.payment_deadline" t-options='{"widget": "datetime"}'/>
                                <div t-else="">
                                    <span t-out="doc.payment_deadline_hours"/> horas desde la adjudicación
                                </div>
                            </div>
                        </div>

                        <p class="mt-4 small">
                            Pago con Mercado Pago. Si el pago no se recibe dentro del plazo,
                            la prenda se ofrece al siguiente postor.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
