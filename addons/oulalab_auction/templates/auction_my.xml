<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="auction_my_template" name="OulaLab Mis subastas">
        <t t-call="website.layout">
            <div class="container my-5 oulalab-my-auctions">
                <div class="mb-3 d-flex gap-2 flex-wrap">
                    <a href="/auctions" class="btn btn-outline-dark btn-sm">← Volver a las subastas</a>
                </div>
                <h1 class="mb-2">Mis subastas</h1>
                <t t-if="partner and request.env.user._is_public()">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <span class="small text-muted">Sesión de <strong t-out="partner.name"/> (RUT <t t-out="partner.vat"/>).</span>
                        <a href="/auctions/guest/logout" class="btn btn-sm btn-outline-danger">Salir / cambiar de RUT</a>
                    </div>
                </t>

                <t t-if="not partner">
                    <div class="row justify-content-center">
                        <div class="col-12 col-md-7 col-lg-5">
                            <t t-call="oulalab_auction.guest_login_box">
                                <t t-set="guest_box_title" t-value="'Ingresa para ver tus subastas'"/>
                            </t>
                            <p class="text-center mt-3 mb-0">
                                <a href="/auctions">Ver las subastas activas</a>
                            </p>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <t t-if="alerts">
                        <div class="alert alert-danger">
                            <strong t-out="alerts"/> de tus subastas <strong>fueron superadas</strong>.
                            Revisa si quieres volver a ofertar antes de que cierren.
                        </div>
                    </t>

                    <t t-if="not rows">
                        <div class="alert alert-light border">Aún no has hecho ninguna oferta en subastas.</div>
                    </t>

                    <div class="table-responsive" t-if="rows">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Prenda</th>
                                    <th class="text-end">Tu oferta</th>
                                    <th class="text-end">Oferta más alta</th>
                                    <th class="text-center">N.º ofertas</th>
                                    <th>Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rows" t-as="r">
                                    <tr t-att-class="'table-danger' if r['alert'] else ''">
                                        <td t-out="r['name']"/>
                                        <td class="text-end">$ <t t-out="r['my_amount']"/></td>
                                        <td class="text-end">$ <t t-out="r['highest']"/></td>
                                        <td class="text-center" t-out="r['bid_count']"/>
                                        <td>
                                            <span t-attf-class="badge text-bg-#{r['tone']}" t-out="r['label']"/>
                                            <div t-if="r['min_next']" class="small text-muted">
                                                Oferta mínima para subir: $ <t t-out="r['min_next']"/>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <a t-attf-href="/auctions/#{r['id']}"
                                               t-attf-class="btn btn-sm #{'btn-danger' if r['alert'] else 'btn-outline-dark'}">
                                                <t t-if="r['alert']">Volver a ofertar</t>
                                                <t t-else="">Ver</t>
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <a href="/auctions/mis-subastas" class="btn btn-link px-0">Actualizar</a>
                </t>
            </div>
        </t>
    </template>
</odoo>
