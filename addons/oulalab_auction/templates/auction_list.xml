<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="auction_list_template" name="OulaLab Auctions">
        <t t-call="website.layout">
            <div class="container my-5 oulalab-auctions">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <h1 class="mb-0">Liquidación OulaLab</h1>
                    <a href="/auctions/mis-subastas" class="btn btn-outline-dark btn-sm">Mis subastas</a>
                </div>
                <p class="text-muted mb-4">
                    Prendas que salen del alquiler. Los socios OulaLab subastan primero.
                </p>

                <form method="get" action="/auctions" class="row g-2 mb-4">
                    <div class="col-12 col-md-4">
                        <select name="marca" class="form-select" aria-label="Marca">
                            <option value="">Todas las marcas</option>
                            <t t-foreach="marcas" t-as="m">
                                <option t-att-value="m" t-att-selected="m == marca_sel" t-out="m"/>
                            </t>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <select name="tipo" class="form-select" aria-label="Tipo de prenda">
                            <option value="">Todos los tipos</option>
                            <t t-foreach="tipos" t-as="tp">
                                <option t-att-value="tp.id" t-att-selected="str(tp.id) == tipo_sel" t-out="tp.name"/>
                            </t>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <select name="ocasion" class="form-select" aria-label="Ocasión">
                            <option value="">Todas las ocasiones</option>
                            <t t-foreach="ocasiones" t-as="oc">
                                <option t-att-value="oc.id" t-att-selected="str(oc.id) == ocasion_sel" t-out="oc.display_name"/>
                            </t>
                        </select>
                    </div>
                    <div class="col-6 col-md-1">
                        <button type="submit" class="btn btn-dark w-100">Filtrar</button>
                    </div>
                    <div class="col-6 col-md-1">
                        <a href="/auctions" class="btn btn-outline-secondary w-100">Limpiar</a>
                    </div>
                </form>

                <t t-if="not auctions">
                    <div class="alert alert-info">No hay subastas activas por ahora.</div>
                </t>

                <div class="row g-4">
                    <t t-foreach="auctions" t-as="auction">
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm oulalab-auction-card">
                                <t t-set="imgs" t-value="auction._get_image_urls()"/>
                                <t t-if="len(imgs) &gt; 1">
                                    <div t-attf-id="auctionCarousel#{auction.id}"
                                         class="carousel slide oulalab-auction-carousel"
                                         data-bs-ride="carousel" data-bs-pause="hover"
                                         t-att-data-bs-interval="6000 + (auction.id % 5) * 400">
                                        <div class="carousel-inner">
                                            <t t-foreach="imgs" t-as="img">
                                                <div t-attf-class="carousel-item #{'active' if img_index == 0 else ''}">
                                                    <a t-attf-href="/auctions/#{auction.id}">
                                                        <img t-att-src="img" class="card-img-top d-block w-100" alt="Prenda"/>
                                                    </a>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <a t-attf-href="/auctions/#{auction.id}">
                                        <img t-att-src="auction._get_primary_image_url()"
                                             class="card-img-top" alt="Prenda"/>
                                    </a>
                                </t>
                                <div class="card-body d-flex flex-column">
                                    <span t-attf-class="oulalab-state mb-2 #{'oulalab-state--live' if auction.state == 'live' else ''}">
                                        <t t-out="dict(auction._fields['state'].selection).get(auction.state)"/>
                                    </span>
                                    <h5 class="card-title">
                                        <t t-out="auction.web_title or 'Prenda en subasta'"/>
                                    </h5>
                                    <p class="small text-muted mb-1" t-if="auction.size">
                                        Talla: <strong t-out="auction.size"/>
                                    </p>
                                    <p class="mb-1">
                                        <small class="text-muted">Precio mínimo</small><br/>
                                        <strong><t t-out="auction.currency_id.symbol"/><t t-out="'{:,.0f}'.format(auction.reserve_price)"/></strong>
                                    </p>
                                    <p class="mb-1">
                                        <small class="text-muted">Última oferta</small><br/>
                                        <t t-if="auction.highest_amount">
                                            <strong class="oulalab-last-bid"><t t-out="auction.currency_id.symbol"/><t t-out="'{:,.0f}'.format(auction.highest_amount)"/></strong>
                                        </t>
                                        <t t-else="">
                                            <span class="text-muted">Sin ofertas todavía</span>
                                        </t>
                                    </p>
                                    <p class="mb-1 small text-muted" t-if="auction.retail_price">
                                        Precio retail de referencia:
                                        <strong><t t-out="auction.currency_id.symbol"/><t t-out="'{:,.0f}'.format(auction.retail_price)"/></strong>
                                    </p>
                                    <div class="oulalab-timer mt-auto"
                                         t-att-data-end="auction.end_date"
                                         t-att-data-now="now">
                                        <small class="text-muted">Cierra en </small>
                                        <span class="timer-value fw-bold">—</span>
                                    </div>
                                    <a t-attf-href="/auctions/#{auction.id}"
                                       class="btn btn-dark btn-lg w-100 mt-3">Ver y subastar</a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
