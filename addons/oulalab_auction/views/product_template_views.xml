<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_auction" model="ir.ui.view">
        <field name="name">product.template.form.auction</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object" name="action_open_auctions"
                        class="oe_stat_button" icon="fa-gavel"
                        invisible="auction_count == 0">
                    <field name="auction_count" widget="statinfo" string="Subastas"/>
                </button>
                <button type="object" name="action_open_auction_web"
                        class="oe_stat_button" icon="fa-external-link"
                        invisible="auction_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Ver en web</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
